rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Regra para a pasta de solicitações de agricultores
    match /requests/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Nova regra específica para uploads de técnicos em nome de agricultores
    match /requests/{farmerId}/{technicianId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == technicianId;
    }

    // Regra para laudos
    match /laudos/{requestId}/{allPaths=**} {
       allow read: if request.auth != null;
       allow write: if request.auth != null;
    }
  }
}
