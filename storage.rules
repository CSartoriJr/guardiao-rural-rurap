rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Regra simplificada: Permite a leitura e escrita na pasta 'requests'
    // para qualquer usuário que esteja autenticado no sistema.
    // Isso cobre o cenário do agricultor e do técnico.
    match /requests/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Regra para laudos: Permite que qualquer usuário autenticado
    // leia e escreva, o que é necessário para técnicos fazerem upload
    // e agricultores/outros visualizarem.
    match /laudos/{allPaths=**} {
       allow read: if request.auth != null;
       allow write: if request.auth != null;
    }
  }
}
