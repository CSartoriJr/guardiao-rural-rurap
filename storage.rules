rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permite a leitura pública de todos os arquivos.
    // A escrita continua protegida e só é permitida através de URLs assinadas
    // ou por usuários autenticados, dependendo de outras regras que possam ser adicionadas.
    match /{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}
