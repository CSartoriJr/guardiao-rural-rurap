rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permite que qualquer usuário autenticado leia e escreva na pasta 'requests'
    // A estrutura de pastas deve ser /requests/{userId}/[nome-do-arquivo]
    match /requests/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Permite que qualquer usuário autenticado leia e escreva na pasta 'laudos'
    // A estrutura de pastas deve ser /laudos/{requestId}/[nome-do-arquivo]
    match /laudos/{requestId}/{allPaths=**} {
       allow read: if request.auth != null;
       allow write: if request.auth != null; // Permite que técnicos façam upload
    }
  }
}
