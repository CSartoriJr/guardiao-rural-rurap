rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /requests_images/{userId}/{allPaths=**} {
      // Permite que qualquer usuário autenticado leia as imagens.
      allow read: if request.auth != null;
      // Permite a escrita se o usuário logado for o dono da pasta (agricultor)
      // OU se o usuário logado for um técnico.
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tecnico');
    }
  }
}