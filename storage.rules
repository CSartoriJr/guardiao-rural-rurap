rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permite que técnicos façam upload em nome de agricultores,
    // e que agricultores façam upload em suas próprias pastas.
    match /requests/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'technician');
    }

    // Permite que usuários autenticados leiam e escrevam laudos.
    // Isso é seguro porque o nome do arquivo é um UUID, o que o torna não adivinhável.
    match /laudos/{requestId}/{allPaths=**} {
       allow read: if request.auth != null;
       allow write: if request.auth != null;
    }
  }
}
