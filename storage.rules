rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permite a leitura e escrita de arquivos por qualquer usuário autenticado.
    // Em um ambiente de produção mais restrito, você poderia limitar a escrita
    // a pastas específicas do usuário (ex: match /users/{userId}/{allPaths=**})
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
