rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Regra para as solicitações:
    // Permite leitura para qualquer usuário autenticado.
    // Permite escrita se:
    // 1. O usuário autenticado é o dono da pasta (o próprio agricultor).
    // OU
    // 2. O usuário autenticado tem a função de 'technician'.
    match /requests/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'technician');
    }

    // Regra para os laudos:
    // Permite leitura e escrita para qualquer usuário autenticado.
    // Isso permite que técnicos façam upload e que agricultores e outros usuários autorizados leiam.
    match /laudos/{requestId}/{allPaths=**} {
       allow read: if request.auth != null;
       allow write: if request.auth != null;
    }
  }
}
