
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the requesting user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the users collection
    match /users/{userId} {
      // 1. Any authenticated user can read another user's profile (e.g., for a technician to see farmer details).
      // 2. An admin can create a user document (this allows the server-side flow to work).
      // 3. A user can only update or delete their own document.
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the requests collection
    match /requests/{requestId} {
      // Allow creation if:
      // 1. The user is the farmer themselves.
      // 2. The user is a technician (creating on behalf of a farmer).
      allow create: if request.auth != null &&
                    (request.auth.uid == request.resource.data.farmerId ||
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'technician');

      // Allow reading if:
      // 1. The user is the farmer who owns the request.
      // 2. The user is a technician or an admin.
      allow read: if request.auth != null &&
                  (request.auth.uid == resource.data.farmerId ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['technician', 'admin']);

      // Allow updates if:
      // 1. The user is a technician (e.g., to add a recommendation).
      // 2. The user is an admin.
      allow update: if request.auth != null &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['technician', 'admin'];

      // Allow deletion only if the user is an admin.
      allow delete: if isAdmin();
    }
  }
}
