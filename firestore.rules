
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow a user to create their own document (for farmer self-registration).
      // All other user creation (technician, admin, farmer-by-technician) MUST be
      // handled by a secure server-side flow (like a Genkit Flow), which bypasses these rules.
      allow create: if request.auth.uid == userId;

      // Allow a user to read their own document.
      // Allow admins and technicians to read any user document.
      allow read: if request.auth.uid != null && 
                  (request.auth.uid == userId || 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['technician', 'admin']);
      
      // Allow a user to update their own document.
      // Admins can also update any user document (e.g., to assign municipalities to a technician).
      allow update: if request.auth.uid != null && 
                    (request.auth.uid == userId ||
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // Only admins can delete user documents.
      allow delete: if request.auth.uid != null &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /requests/{requestId} {
      // Allow creation if the user is the farmer themselves OR if the request is being made by a technician.
      allow create: if request.auth.uid != null && 
                    (request.auth.uid == request.resource.data.farmerId || 
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'technician');

      // Allow read for the farmer who owns the request, or for technicians/admins.
      allow read: if request.auth.uid != null && 
                  (request.auth.uid == resource.data.farmerId ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['technician', 'admin']);

      // Allow technicians and admins to update requests (e.g., to add a recommendation).
      allow update: if request.auth.uid != null &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['technician', 'admin'];

      // Only admins can delete requests.
      allow delete: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
